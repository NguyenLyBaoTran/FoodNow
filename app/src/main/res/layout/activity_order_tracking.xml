<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        app:title="Order Tracking"
        app:titleTextColor="@color/text_primary" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvOrderPlacedTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Order Tracking"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOrderPlacedSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="We are processing your order."
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Timeline Statuses -->
                    <LinearLayout
                        android:id="@+id/statusOrderPlaced"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:id="@+id/imgDot1"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/bg_green_corner_button"
                            app:tint="@color/success" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:text="Order placed"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="2dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="7dp"
                        android:background="@color/colorLightGray" />

                    <LinearLayout
                        android:id="@+id/statusPaymentConfirmed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:id="@+id/imgDot2"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/bg_green_corner_button"
                            app:tint="@color/success"
                            android:alpha="0.3" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:text="Payment confirmed"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="2dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="7dp"
                        android:background="@color/colorLightGray" />

                    <LinearLayout
                        android:id="@+id/statusWaitingDriver"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:id="@+id/imgDot3"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/bg_green_corner_button"
                            app:tint="@color/success"
                            android:alpha="0.3" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:text="Waiting for driver"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="2dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="7dp"
                        android:background="@color/colorLightGray" />

                    <LinearLayout
                        android:id="@+id/statusOnTheWay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:id="@+id/imgDot4"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/bg_green_corner_button"
                            app:tint="@color/success"
                            android:alpha="0.3" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:text="On the way"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="2dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="7dp"
                        android:background="@color/colorLightGray" />

                    <LinearLayout
                        android:id="@+id/statusDelivered"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:id="@+id/imgDot5"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/bg_green_corner_button"
                            app:tint="@color/success"
                            android:alpha="0.3" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:text="Delivered"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="Order Summary"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvOrderId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Order #1024"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Total: 0 VND"
                        android:textColor="@color/colorPrimary"
                        android:textStyle="bold"
                        android:textSize="18sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <Button
                android:id="@+id/btnViewOrder"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                style="@style/AppButton.Primary"
                android:text="View Order Details" />

            <Button
                android:id="@+id/btnBack"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                style="@style/AppButton.Secondary"
                android:text="Back to My Orders" />

            <Button
                android:id="@+id/btnCancelOrder"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                style="@style/AppButton.Destructive"
                android:text="Cancel Order"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="40dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
